class Solution {
public:
    bool isValidSudoku(vector<vector<char>>& board) {
        for (int i = 0; i < board.size(); i++) {
            int rowCountArray[9] = {0};
            int columnCountArray[9] = {0};
            for (int j = 0; j < board[i].size(); j++) {
                if (board[i][j] != '.') {
                    rowCountArray[board[i][j]  - '0' - 1]++;
                    if(rowCountArray[board[i][j]- '0' - 1] == 2){
                        return false;
                    }
                } 
                if (board[j][i] != '.') {
                    columnCountArray[board[j][i]  - '0' - 1]++;
                    if(columnCountArray[board[j][i]- '0' - 1] == 2){
                        return false;
                    }
                }
            }
        }
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                int boxCountArray[9] = {0};
                for (int k = 0; k < 3; k++) {
                    for (int l = 0; l < 3; l++) {
                        if (board[3*i+k][3*j+l] != '.') {
                            boxCountArray[board[3*i+k][3*j+l]  - '0' - 1]++;
                            if(boxCountArray[board[3*i+k][3*j+l] - '0' - 1] == 2){return false;}
                        } 
                    }
                }
            }
        }
        return true;
    }
};
